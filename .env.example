# Variables lues par le conteneur à l'exécution (jamais au build). Copier en
# `.env` pour `docker compose up` en local ; en production, les saisir dans
# l'onglet « Environment » de l'application Dokploy. Toutes sont facultatives :
# vides, le site tourne et affiche un repli clair.

# Port d'écoute du serveur Node dans le conteneur.
PORT=3000

# Formulaire /contact, envoyé par l'API transactionnelle Brevo (compte
# Cardona). Sans BREVO_API_KEY, CONTACT_TO_EMAIL ou CONTACT_FROM_EMAIL, le
# formulaire annonce qu'il n'est pas branché et renvoie vers l'e-mail. La clé
# reste côté serveur : jamais envoyée au navigateur.
BREVO_API_KEY=
# Boîte qui reçoit les demandes (Répondre écrit directement au prospect).
CONTACT_TO_EMAIL=
# Expéditeur des deux e-mails : une adresse d'un domaine authentifié dans
# Brevo, par exemple contact@cardona.digital.
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=Agence Cardona
# Facultatif : identifiant numérique d'une liste Brevo où ajouter chaque
# prospect.
BREVO_LIST_ID=
# Test local seulement : faire pointer les appels vers un serveur factice.
# Vide en production (https://api.brevo.com/v3 par défaut).
BREVO_API_URL=

# Page de réservation Google Agenda (agenda de prise de rendez-vous) affichée
# en iframe sur /rendez-vous. Doit commencer par https://. Vide : bloc de
# repli qui renvoie vers /contact.
BOOKING_URL=

# Cloudflare Turnstile sur /contact : actif seulement si les deux sont
# renseignées. La clé de site est publique, le secret reste côté serveur.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
